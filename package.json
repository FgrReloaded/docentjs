{
  "name": "docentjs",
  "private": true,
  "version": "0.0.0",
  "description": "Docent monorepo \u2014 guided product tours for the web (and beyond).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FgrReloaded/docentjs.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "size": "size-limit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "playwright": "^1.63.0",
    "size-limit": "^14.0.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
