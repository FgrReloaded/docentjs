{
  "name": "docentjs",
  "private": true,
  "version": "0.0.0",
  "description": "Docent monorepo \u2014 guided product tours for the web (and beyond).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FgrReloaded/docentjs.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:site": "turbo run build --filter=@docentjs/docs... --filter='@docentjs/example-*...' && node scripts/collect-examples.mjs",
    "capture:examples": "node scripts/capture-example-previews.mjs",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "size": "size-limit",
    "gen:schema": "node scripts/gen-schema.mjs",
    "check:publish": "pnpm -r --filter './packages/*' exec publint --strict && pnpm -r --filter './packages/*' exec attw --pack . --profile node16",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "release:stage": "node scripts/stage-release.mjs",
    "release:approve": "node scripts/approve-release.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "size-limit": "^14.0.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
