{
  "name": "@docentjs/vue",
  "version": "0.8.0",
  "description": "Vue bindings for Docent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FgrReloaded/docentjs.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/FgrReloaded/docentjs/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/FgrReloaded/docentjs/issues"
  },
  "keywords": [
    "product-tour",
    "guided-tour",
    "onboarding",
    "walkthrough",
    "spotlight",
    "tooltip",
    "docent"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@docentjs/core": "workspace:^",
    "@docentjs/dom": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "vue": "^3.5.43"
  }
}
