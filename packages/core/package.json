{
  "name": "@docentjs/core",
  "version": "0.10.3",
  "description": "Platform-agnostic tour engine: schema, state machine, triggers, persistence, events. No DOM access.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FgrReloaded/docentjs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/FgrReloaded/docentjs/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/FgrReloaded/docentjs/issues"
  },
  "keywords": [
    "product-tour",
    "guided-tour",
    "onboarding",
    "walkthrough",
    "spotlight",
    "tooltip",
    "docent"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate.d.ts",
        "default": "./dist/validate.js"
      },
      "require": {
        "types": "./dist/validate.d.cts",
        "default": "./dist/validate.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public"
  }
}
